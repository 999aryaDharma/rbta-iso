# RBTA + Isolation Forest — Proxmox CT production.
# Salin menjadi deploy/ct/.env DI DALAM CT. Jangan commit file hasilnya.
# Semua kredensial di bawah ini WAJIB segar (putar yang pernah tersingkap).

# --- Identitas layanan (buat baru, jangan pakai ulang dev) ---
RBTA_API_KEY=ganti-dengan-token-produksi-yang-panjang
RBTA_MODEL_VERSION=rbta-if-v1
# Guard identitas model: sha256 isolation_forest.joblib versi di atas. Bila diisi dan
# berbeda dari bundle yang dimuat, service menolak start. Kosong = guard nonaktif.
# Hitung di CT:  sha256sum "$RBTA_MODEL_HOST_DIR/<versi>/isolation_forest.joblib"
# (atau lihat key "isolation_forest.joblib" di manifest.json bundle).
# rbta-if-thesis-v1 = 0447550cd531cb88dc5d5ef60ed50fd525e201b154ba999d5fa84f2c3a6432f4
RBTA_EXPECTED_MODEL_SHA256=
# Δt dasar RBTA live (menit). Kosong = 15 (default kode). Model rbta-if-thesis-v1
# dilatih dari MetaAlert dengan Δt = 10 (phase_a_results.json); isi 10 untuk paritas.
# Mengubahnya pada state yang sudah berjalan mencampur Δt antar agen: pakai state baru.
RBTA_BASE_DELTA_T_MIN=
RBTA_HOST_PORT=8010

# --- Agen uji yang TIDAK di-ingest live (dipisah koma; nama atau ID agen, case-insensitive).
# Alertnya tidak masuk RBTA/evidence; hanya dihitung di excluded_alerts_total.
RBTA_EXCLUDED_AGENTS=agent-test,test-n8n

# --- Override kekritisan agen (JSON {nama_atau_id: 1-4}) di atas AGENT_CRITICALITY bawaan.
# Kosong = tabel bawaan src/config/domain.py (perilaku skripsi). Salin
# deploy/ct/config/agent_criticality.example.json -> agent_criticality.json lalu isi
# (contoh berisi nilai 1 = default; nilai sebenarnya keputusan peneliti). Path di
# DALAM container (deploy/ct/config di-mount read-only ke /app/config):
#   RBTA_AGENT_CRITICALITY_FILE=/app/config/agent_criticality.json
# Ini perubahan metode (fitur agent_criticality): catat sha256-nya (lihat /api/v1/live/status).
# Mengubah pemetaan mengubah derivation hash: worker menolak start sampai
# RBTA_LIVE_DERIVATION_OVERRIDE=<hash baru> diset sekali (lihat runbook).
RBTA_AGENT_CRITICALITY_FILE=

# --- Live source (indexer = default produksi kampus) ---
RBTA_LIVE_SOURCE=indexer
RBTA_LIVE_POLL_INTERVAL_SEC=5.0
RBTA_ORDER_BUFFER_ENABLED=false

# --- Indexer kampus (jangan commit nilai asli) ---
WAZUH_INDEXER_HOST_IP=172.16.83.207
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USERNAME=arya
WAZUH_INDEXER_PASSWORD=ganti-dengan-password-reader-setelah-rotasi

# --- Telegram live dispatch (sudah terbukti konektivitasnya) ---
RBTA_TELEGRAM_BOT_TOKEN=ganti-dengan-token-bot
RBTA_TELEGRAM_CHAT_ID=ganti-dengan-chat-id

# --- Ekspor bukti harian (CSV di volume live: /app/data/live/evidence), jam WITA ---
RBTA_EVIDENCE_EXPORT_AT=00:05

# --- Daily digest NOISE_HIGH ke Telegram (jam WITA). URL dashboard opsional untuk tautan.
RBTA_DIGEST_AT=07:30
RBTA_DIGEST_ENABLED=true
RBTA_DASHBOARD_URL=http://<ip-ct>:8010/dashboard

# --- Arsip live -> replay ---
RBTA_LIVE_ARCHIVE_ENABLED=true

# --- Host path di CT (sesuaikan) ---
# Berisi subdirektori per versi model, mis. models/rbta-if-v1/.
# models/ TIDAK ikut git — transfer manual via scp dari laptop.
RBTA_MODEL_HOST_DIR=/root/rbta/models

# --- Build ---
RBTA_IMAGE_TAG=ct
RBTA_LOG_LEVEL=INFO
RBTA_CPU_LIMIT=2.00
RBTA_MEMORY_LIMIT=3072M
RBTA_PIDS_LIMIT=200
