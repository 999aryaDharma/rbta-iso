# ==============================================================================
# RBTA + Isolation Forest — ASUS Production Deployment Environment Template
# ==============================================================================
# Copy this file to `deploy/asus/.env` and supply production values before deployment.
#
# DO NOT set RBTA_IMAGE_TAG or RBTA_BUILD_DATE:
# These are generated deterministically by `scripts/deploy/asus-deploy.sh` from the
# tested CODE_SHA in .agents/campaign/STATE.json.
# ==============================================================================

# Mandatory API Authentication Key for RBTA service and dashboard
RBTA_API_KEY=production-secure-random-api-token-change-me

# Model Version corresponding to the artifact directory in RBTA_MODEL_HOST_DIR
RBTA_MODEL_VERSION=reference-v1

# Host port for RBTA API and Dashboard (must be between 1024 and 65535)
RBTA_HOST_PORT=8010

# Source Mode for Alert Ingestion (DEFERRED for historical replay / campus demo)
RBTA_SOURCE_MODE=DEFERRED

# Logging Level (DEBUG, INFO, WARNING, ERROR)
RBTA_LOG_LEVEL=INFO

# Host Filesystem Storage Directories
# Note: Replay archive is mounted READ-ONLY (:ro); State is mounted READ-WRITE (:rw).
RBTA_STATE_HOST_DIR=/srv/rbta-iso/state
RBTA_MODEL_HOST_DIR=/srv/rbta-iso/models
RBTA_REPLAY_HOST_DIR=/srv/rbta-iso/replay
