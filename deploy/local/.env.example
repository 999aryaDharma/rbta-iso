# RBTA + Isolation Forest — Lenovo / Docker Desktop
# Salin ke deploy/local/.env. Jangan commit file .env hasilnya.

RBTA_API_KEY=ganti-dengan-token-demo-lokal-yang-panjang
RBTA_MODEL_VERSION=reference-v1
RBTA_HOST_PORT=8010
RBTA_SOURCE_MODE=DEFERRED
RBTA_LOG_LEVEL=INFO

# Path native PowerShell / Docker Desktop. Pakai garis miring biasa agar tidak perlu escape.
RBTA_REPLAY_HOST_DIR=D:/KAMPUS/SKRIPSI/wazuh-data-2026/indexer-export

# Direktori yang berisi folder versi model, mis. models/reference-v1/.
# Path relatif ini di-resolve launcher dari root repository.
RBTA_MODEL_HOST_DIR=./models

# Default untuk Lenovo; naikkan hanya setelah melihat utilisasi host yang sebenarnya.
RBTA_CPU_LIMIT=4.00
RBTA_MEMORY_LIMIT=4096M
RBTA_PIDS_LIMIT=200
