# Template environment service RBTA + Isolation Forest.
# Salin ke .env lalu isi nilainya. Jangan commit kredensial, API key, atau token asli.

# --- Wajib ---

# API key REST. Service tidak mau start bila kosong.
# Pakai token acak yang panjang; melindungi /api/v1/* dan /runtime/stats.
RBTA_API_KEY=change-this-to-a-secure-random-token

# Versi model aktif. Service tidak mau start bila kosong.
# Harus sama dengan nama subdirektori di registry model (mis. models/<version>).
# 'deploy-smoke-v1' hanya artefak smoke untuk CI/test, bukan model akhir penelitian.
RBTA_MODEL_VERSION=deploy-smoke-v1

# --- Operasional ---

# Port loopback host (default 8000).
RBTA_HOST_PORT=8000

# Level log (DEBUG, INFO, WARNING, ERROR).
RBTA_LOG_LEVEL=INFO

# Batas resource container.
RBTA_CPU_LIMIT=2.00
RBTA_MEMORY_LIMIT=1024M
RBTA_PIDS_LIMIT=100
RBTA_CPU_RESERVATION=0.25
RBTA_MEMORY_RESERVATION=256M

# --- Integrasi live (isi setelah jalur jaringan, kredensial, dan sertifikat TLS kampus pasti) ---

# Polling Wazuh Indexer.
# WAZUH_INDEXER_URL=https://127.0.0.1:9200
# WAZUH_INDEXER_USERNAME=wazuh_poller
# WAZUH_INDEXER_PASSWORD=placeholder-password
# WAZUH_INDEXER_VERIFY_TLS=true
# WAZUH_INDEXER_CA_BUNDLE=/app/certs/root-ca.pem

# Sumber live lewat custom flat API (kontrak dibekukan 2026-10-03, lihat FLAT-API-FREEZE).
# Memanggil API perantara {events,total,limit,offset}, bukan Indexer langsung.
# RBTA_LIVE_SOURCE=api untuk memakai WazuhAPILivePoller (default indexer).
# RBTA_LIVE_SOURCE=indexer
# WAZUH_API_URL=https://172.16.83.207/api
# WAZUH_API_KEY=placeholder-api-key
# WAZUH_API_SESSION_COOKIE=placeholder-session-cookie (alternatif Bearer; jangan commit nilai asli)
# Auto-relogin + watcher file sesi (jangan commit nilai asli):
# WAZUH_API_USERNAME=svc-reader@kampus
# WAZUH_API_PASSWORD=placeholder-password
# WAZUH_API_LOGIN_PATH=/auth/login
# WAZUH_API_SESSION_FILE=data/runtime/api_session.json
# WAZUH_API_VERIFY_TLS=true
# WAZUH_API_CA_PATH=/app/certs/api-ca.pem

# Forwarder outbox ke Shuffle SOAR.
# SHUFFLE_WEBHOOK_URL=https://shuffle.internal/api/v1/hooks/webhook_id
# SHUFFLE_API_KEY=placeholder-shuffle-key
